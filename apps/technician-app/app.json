{
  "expo": {
    "name": "technician-app",
    "slug": "technician-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img2_main_icon_square.png",
    "userInterfaceStyle": "light",
    "scheme": "fixmate",
    "entryPoint": "./index.ts",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/img1_foreground.png",
        "backgroundImage": "./assets/img1_background.png",
        "monochromeImage": "./assets/img2_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.babakhalilmsteam.technicianapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "https://landing-website-orpin.vercel.app/",
              "pathPrefix": "/technician-login"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/img2_main_icon_square.png",
      "config": {
        "googleMapsApiKey": "YOUR_WEB_GOOGLE_MAPS_API_KEY"
      },
      "build": {
        "babel": {
          "include": ["@react-navigation"]
        }
      }
    },
    "extra": {
      "webStyles": {
        "inject": true
      },
      "eas": {
        "projectId": "4b6531e5-d28e-4af8-858d-2e03d8212dbd"
      }
    },
    "owner": "babakhalilms-team",

    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "fixmate_technician",
          "organization": "babakhalilms-team"
        }
      ]
    ]
  }
}
