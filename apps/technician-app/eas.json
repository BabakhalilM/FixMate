      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_ORG": "babakhalilms-team",
        "SENTRY_PROJECT": "react-native"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
