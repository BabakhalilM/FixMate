{
  "name": "fixmate",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.2.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx turbo dev",
    "build": "npx turbo build",
    "start": "node apps/api-server/dist/index.js",
    "vercel-build": "npm install && npx turbo build",
    "eas-build-pre-install": "npm install && npx turbo build --filter=@fixmate/api-client --filter=@fixmate/shared-types --filter=@fixmate/utils"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.19",
    "@angular-devkit/core": "^21.2.19",
    "@angular-devkit/schematics": "^21.2.19",
    "@expo/config-plugins": "~8.0.0",
    "@swc/helpers": "^0.5.19",
    "turbo": "^1.10.0"
  },
  "dependencies": {
    "merge-options": "^3.0.4"
  }
}
